// Cloudflare Workers deployment: a static-assets-only Worker serving the Vite build.
{
  "name": "koebelt",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Every real route is prerendered to its own file (scripts/prerender.mjs), so
    // /work/:slug is served as work/:slug.html. Anything else gets the prerendered
    // not-found page with a real 404 status, rather than the home page with a 200.
    "not_found_handling": "404-page"
  }
}
