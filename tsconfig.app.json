{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* The design system ships untyped .jsx with sibling .d.ts files.
       checkJs stays off so its internals are never typechecked; the hand-written
       design_system/index.d.ts barrel is the single source of component types. */
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@ds": ["./design_system/index.d.ts"],
      "@ds/*": ["./design_system/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "design_system/index.d.ts"]
}
